# Production server binding. Override the port when 8090 is unavailable.
HOST=0.0.0.0
PORT=8090

# Initial read-only ROM library. Files may be here or in nested folders.
# Settings persists later changes in SQLite.
ROM_LIBRARY_PATH=./sample-library

# Persistent application paths. Keep them separate from the source tree in deployment.
DATA_DIR=./runtime/data
SAVES_DIR=./runtime/saves
ARTWORK_DIR=./runtime/data/artwork

# Development UI only. Vite proxies API requests to DEV_SERVER_URL.
DEV_UI_HOST=0.0.0.0
DEV_UI_PORT=5173
DEV_SERVER_URL=http://127.0.0.1:8090
